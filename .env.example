# ---- Meta app (one app serves both accounts) ----
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://your-vps.example.com/callback

# ---- Accounts the secretary manages ----
IG_ACCOUNTS=anova.autismo,pankeka.app

IG_ANOVA_AUTISMO_USER_ID=
IG_ANOVA_AUTISMO_TOKEN=

IG_PANKEKA_APP_USER_ID=
IG_PANKEKA_APP_TOKEN=

# Optional: pin the Graph API version. Check Meta's changelog before bumping.
# IG_API_VERSION=v23.0
